    "@fontsource/alegreya-sans": "5.2.8",
    "@fontsource/cormorant-sc": "5.2.8",
    "@playwright/test": "1.56.1",
    "@types/three": "0.170.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-plugin-singlefile": "2.3.0"
  },
  "dependencies": {
    "three": "0.170.0"
  }
}
